<file path=".pre-commit-config.yaml">
# Copyright 2025 Darian Lee
#
# Licensed under the Apache License, Version 2.0 (the "License");
# you may not use this file except in compliance with the License.
# You may obtain a copy of the License at
#
#     http://www.apache.org/licenses/LICENSE-2.0
#
# Unless required by applicable law or agreed to in writing, software
# distributed under the License is distributed on an "AS IS" BASIS,
# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
# See the License for the specific language governing permissions and
# limitations under the License.

---

repos:
  # --- General File Hygiene ---
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v6.0.0
    hooks:
      - id: trailing-whitespace
      - id: end-of-file-fixer
      - id: check-yaml
      - id: check-json
      - id: check-added-large-files
      - id: check-merge-conflict

  # --- Terraform ---
  - repo: https://github.com/antonbabenko/pre-commit-terraform
    rev: v1.103.0
    hooks:
      - id: terraform_fmt
      - id: terraform_validate
      - id: terraform_tflint
      - id: terraform_docs
        args: ["--args=--sort-by", "required"]

  # --- Python (Formatting & Linting) ---
  # Use the mirror that provides pre-commit hooks
  - repo: https://github.com/psf/black-pre-commit-mirror
    rev: 25.9.0
    hooks:
      - id: black

  - repo: https://github.com/PyCQA/flake8
    rev: 7.3.0
    hooks:
      - id: flake8
        additional_dependencies:
          - flake8-bugbear
          - flake8-comprehensions
          - flake8-docstrings
        args: ["--max-line-length=100", "--ignore=E203,W503"]

  # --- YAML linting ---
  - repo: https://github.com/adrienverge/yamllint
    rev: v1.37.1
    hooks:
      - id: yamllint
        args: ["-d", "{extends: default, rules: {line-length: disable}}"]

  # --- Local hooks (kubeconform + license enforcement) ---
  - repo: local
    hooks:
      # kubeconform installed on your system (brew install kubeconform)
      - id: kubeconform
        name: kubeconform (K8s)
        entry: kubeconform
        language: system
        files: ^k8s/.*\.(ya?ml)$
        args:
          - -strict
          - -summary
          - -ignore-missing-schemas
          - -kubernetes-version
          - "1.30.0"

      - id: add-apache-headers
        name: Add/Update Apache-2.0 headers
        entry: addlicense -f .license-header.txt
        language: system
        pass_filenames: true
        types_or: [python, yaml, shell, terraform]
        files: |
          (?x)
          ^.*\.(tf|tfvars|yaml|yml|py|sh)$
        exclude: |
          (?x)
          ^(LICENSE|NOTICE|VERSION)$|
          ^\.git/|
          ^docs/|
          ^env/.*/\.gitkeep$|
          ^modules/.*/\.gitkeep$|
          ^\.venv/|
          __pycache__
</file>

