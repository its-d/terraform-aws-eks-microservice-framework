###############################################################################
# Example terraform.tfvars
# -----------------------------------------------------------------------------
# Copy to terraform.tfvars and fill in. Do NOT commit terraform.tfvars.
# Run 'make plan' — it will prompt for Grafana credentials if not set.
###############################################################################

region              = "us-east-1"   # AWS region
identifier          = "myapp"       # Short prefix for resource names
environment         = "dev"        # Optional; default "dev"
owner               = ""           # Optional; default "terraform"

# EKS API access (default allows all; set to restrict by IP)
# public_access_cidrs = ["0.0.0.0/0"]

# Grafana — created by 'make plan' prompt if empty
grafana_admin_user_arn = ""
grafana_admin_pwd_arn  = ""

# Optional HTTPS for Grafana
enable_https   = false
certificate_arn = ""
